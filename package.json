{
  "name": "bills",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --project=bills-main-app",
    "build": "ng build --project=bills-main-app",
    "test": "vitest --run",
    "test:all": "vitest --run",
    "test:model": "vitest --run projects/model/src",
    "test:tools": "vitest --run projects/tools/src",
    "test:store": "vitest --run projects/store/src",
    "test:views": "vitest --run projects/views/src",
    "test:bills-main-app": "vitest --run projects/bills-main-app/src",
    "test:bills-testing-app": "vitest --run projects/bills-testing-app/src",
    "start-testing-app": "ng serve --ssl true --project=bills-testing-app --verbose",
    "build-testing-app": "ng build --configuration production --aot --project=bills-testing-app",
    "test:ui": "vitest --ui",
    "lint": "ng lint",
    "depcruise": "depcruise projects --config .dependency-cruiser.js",
    "depcruise:graph": "depcruise projects --config .dependency-cruiser.js --output-type dot | dot -T svg > dependency-graph.svg",
    "e2e": "ng e2e"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^21.2.8",
    "@angular/cdk": "^21.2.6",
    "@angular/common": "^21.2.8",
    "@angular/compiler": "^21.2.8",
    "@angular/core": "^21.2.8",
    "@angular/forms": "^21.2.8",
    "@angular/material": "^21.2.6",
    "@angular/platform-browser": "^21.2.8",
    "@angular/platform-browser-dynamic": "^21.2.8",
    "@angular/router": "^21.2.8",
    "@ngrx/effects": "^21.1.0",
    "@ngrx/operators": "^21.1.0",
    "@ngrx/store": "^21.1.0",
    "@ngrx/store-devtools": "^21.1.0",
    "@supabase/supabase-js": "^2.103.0",
    "angular-material-styles": "^1.1.21",
    "d3": "^7.9.0",
    "idb": "^8.0.3",
    "material-design-icons": "^3.0.1",
    "material-icons": "^1.13.14",
    "moment": "^2.30.1",
    "rxjs": "^7.5.5",
    "tslib": "^2.6.2"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^2.4.5",
    "@angular-devkit/build-angular": "^21.2.7",
    "@angular-devkit/core": "^21.2.7",
    "@angular-eslint/builder": "^21.3.1",
    "@angular-eslint/eslint-plugin": "^21.3.1",
    "@angular-eslint/eslint-plugin-template": "^21.3.1",
    "@angular-eslint/schematics": "^21.3.1",
    "@angular-eslint/template-parser": "^21.3.1",
    "@angular/cli": "^21.2.7",
    "@angular/compiler-cli": "^21.2.8",
    "@testing-library/angular": "^19.2.1",
    "@types/d3": "^7.4.3",
    "@types/node": "^24.12.2",
    "@typescript-eslint/eslint-plugin": "^8.58.1",
    "@typescript-eslint/parser": "^8.58.1",
    "@vitest/ui": "^4.1.4",
    "dependency-cruiser": "^17.3.10",
    "eslint": "^9.0.0",
    "eslint-config-google": "^0.14.0",
    "globals": "^17.0.0",
    "jsdom": "^27.2.0",
    "ng-packagr": "^21.2.2",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.3",
    "vite": "^7.3.2",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.4"
  }
}
