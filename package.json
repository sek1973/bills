    "start-testing-app": "ng serve --ssl true --project=bills-testing-app --verbose",
    "build-testing-app": "ng build --configuration production --aot --project=bills-testing-app",
    "test:ui": "vitest --ui",
    "lint": "ng lint",
    "e2e": "ng e2e"
